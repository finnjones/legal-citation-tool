# Copy this file to .env and fill in your key. .env is git-ignored.

# OpenRouter chooses the model via Settings > Presets, preset slug `aglc`.
# Change it there; switching models needs no code change or redeploy.
# AGLC_LLM=openrouter:@preset/aglc   # optional: the built-in default already is this

# Optional second model, asked only when the first fails every attempt (eg its
# hosts keep sending empty replies). Any <provider>:<model>; a different model
# family is the safest choice.
# AGLC_LLM_FALLBACK=openrouter:<model id from openrouter.ai/models>

# OpenRouter upstream hosts never to use, comma-separated, as OpenRouter names them
# (default DigitalOcean and Sail Research, which sent empty or partial replies in testing;
# set it empty for none).
# AGLC_OPENROUTER_IGNORE=DigitalOcean,Sail Research
# Only OpenRouter hosts that don't store or train on requests (the privacy page says so)
# AGLC_OPENROUTER_DATA_COLLECTION=deny

# Model "thinking": off (default, much faster) | low | medium | high | default
# AGLC_REASONING=off

# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Other providers, if you use them:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# ---- Paid hosting (optional) ------------------------------------------------
# Payments are off unless AGLC_PAYMENTS is set; local use needs none of this.
# With it on, processing returns a free redacted preview and A$4 unlocks the rest.
# AGLC_PAYMENTS=square            # square | stripe | fake (offline test checkout, no money moves)
# AGLC_DATA_DIR=/var/lib/aglc     # SQLite database and kept documents (default ~/.aglc)
# AGLC_PUBLIC_URL=https://aglc.example.com   # where checkout sends people back to
# AGLC_CLIENT_IP_HEADER=CF-Connecting-IP     # behind a reverse proxy: the real client IP
# AGLC_IP_SALT=                   # optional; a random salt is kept in the database otherwise

# Free-preview limits (checked before any AI model call)
# AGLC_FREE_PER_DAY=3             # per browser
# AGLC_FREE_PER_IP_PER_DAY=15     # per IP address (default 5x the above: campuses share IPs)
# AGLC_FREE_GLOBAL_PER_DAY=300    # everyone together
# AGLC_MAX_FOOTNOTES=400
# AGLC_MAX_CONCURRENT=2
# AGLC_MAX_FAILED_SHARE=0.2       # can't pay while more than this share of footnotes couldn't be read

# Retention and uploads (see DEPLOY.md)
# AGLC_RETENTION_HOURS=24         # documents are deleted this long after upload / checkout / payment (min 1)
# AGLC_REPORT_DAYS=90             # "Report a problem" reports are deleted after this many days (min 1)
# AGLC_MAX_UPLOAD_MB=10           # larger uploads get 413

# Square (pip install 'aglc[square]'). Webhook events: payment.created, payment.updated, refund.updated
# For Apple Pay and Google Pay, also enable them in the Square Dashboard: Payment links > Settings.
# Refunds don't return Square's processing fee.
# SQUARE_ENVIRONMENT=sandbox      # sandbox | production
# SQUARE_ACCESS_TOKEN=
# SQUARE_LOCATION_ID=
# SQUARE_WEBHOOK_SIGNATURE_KEY=
# SQUARE_WEBHOOK_URL=https://aglc.example.com/api/webhooks/square   # exactly as registered with Square

# Stripe Checkout (pip install 'aglc[stripe]'), with AGLC_PAYMENTS=stripe.
# Webhook endpoint <AGLC_PUBLIC_URL>/api/webhooks/stripe; events: checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.expired, charge.refunded
# Test locally: stripe listen --forward-to localhost:8766/api/webhooks/stripe (prints the whsec_ secret)
# Apple Pay and Google Pay come with Checkout. Refunds don't return Stripe's fee (1.65% + 30c).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Site (optional) --------------------------------------------------------
# AGLC_PLAUSIBLE_DOMAIN=cite.example.com   # turns on Plausible analytics (cookieless); off when unset

# Who runs the site, for the Privacy, Terms, Refunds and About pages (see DEPLOY.md 4a)
# AGLC_OWNER_NAME=
# AGLC_CONTACT_EMAIL=
# AGLC_ABN=
# AGLC_STATE=
# AGLC_OWNER_ABOUT=          # optional line for the About page; nothing shows when unset
# AGLC_LOG_RETENTION_DAYS=14
# AGLC_GST_REGISTERED=false

# Limits on the AI model, in seconds: per request (the reply is given up on after this, even if
# the host keeps the connection open) and per document (footnotes not read by then are left as
# written). And a cap on the length of each reply.
# AGLC_REQUEST_DEADLINE=90
# AGLC_DOCUMENT_DEADLINE=300
# AGLC_MAX_OUTPUT_TOKENS=16000
