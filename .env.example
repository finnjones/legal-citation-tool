# Copy this file to .env and fill in your key. .env is git-ignored.

# Which model to use: <provider>:<model>
AGLC_LLM=openrouter:deepseek/deepseek-v4.1-flash

# Optional second model, asked only when the first fails every attempt (eg its
# hosts keep sending empty replies). Any <provider>:<model>; a different model
# family is the safest choice.
# AGLC_LLM_FALLBACK=openrouter:<model id from openrouter.ai/models>

# Model "thinking": off (default, much faster) | low | medium | high | default
# AGLC_REASONING=off

# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Other providers, if you use them:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
